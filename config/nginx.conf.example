# ───────────────────────────────────────────────────────────────
# PHP_blog 伪静态配置（宝塔：网站 → 设置 → 伪静态，整段粘贴）
#
# 前提：网站运行目录指向项目根（含 index.php 那一层）。
# fastcgi_pass 的 socket 路径按实际 PHP 版本改，宝塔一般为 /tmp/php-cgi-XX.sock。
#
# 四处不能省：
#   1. 敏感目录封锁（config/config.php 就是数据库密码，backups/ 是全站 SQL）
#   2. themes/ 模板封锁（否则 base.html 等源码可被下载）
#   3. uploads/ 隐藏文件与脚本封锁（否则上传的 .php 可执行）
#   4. error_page 指向预渲染静态文件 static/{404,403,50x}.html，不可写 /index.php。
#      404 / 403 / 502 恰恰发生在 PHP 通道本身不可用的时候，此时内部再走一次 PHP
#      只会退回 nginx 原生页。静态页由 php bin/build_50x.php 生成（后台切换主题时自动重建）。
#
# ⚠️ location ^~ /avatar/ 务必保留，别当成冗余删掉：
#    头像代理地址形如 /avatar/<key>/<size>.png，以 .png 结尾。nginx 中正则 location 优先于
#    普通前缀 location，而「按后缀的静态资源规则」不止本文件下面那一段——宝塔生成的 server 块
#    或其它 include 常自带 ~* \.(png|jpg|…)$ 之类规则，且正则按出现顺序先到先得，本项目改不到
#    别处那段。一旦被抢先匹配，nginx 就去磁盘找这个不存在的文件、返回 404，请求根本不进 PHP，
#    表现为全站评论头像退化成默认头像、storage/cache/avatars/ 永远为空。
#    ^~ 是前缀优先匹配，命中后不再走任何正则，与书写顺序、外部规则都无关，是唯一稳妥的解。
#
# ⚠️ 切勿追加 location ~* \.sql$ { deny all; } 这类「后缀黑名单」：
#    后台备份下载走 /admin/export/download/*.sql，会被一并拦掉，表现为点「下载」返回 404。
#    backups/ 目录已由下面的目录级规则封锁，无需再按后缀拦。
# ───────────────────────────────────────────────────────────────

# 敏感目录与文件：禁止 Web 访问
location ~ ^/(config|core|storage|data|backups|bin|plugins|docs|fonts)(/|$) { return 404; }
location ~ /\.            { return 404; }
location ^~ /.well-known/ { allow all; }
location ~ ^/themes/.+\.(html|json)$        { return 404; }
location ~ ^/uploads/(.*/)?\.               { return 404; }
location ~* ^/uploads/.*\.(php|phtml|phar)$ { return 404; }

# 伪静态：非真实文件 / 目录交给前端控制器
location / { try_files $uri $uri/ /index.php?$query_string; }

# 头像代理：必须 ^~，理由见文件头
location ^~ /avatar/ { try_files $uri /index.php?$query_string; }

# 静态资源缓存（charset 不可省，否则直出的 css / js 中文乱码）
location ~* \.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf)$ {
    charset utf-8;
    charset_types application/javascript text/css;
    expires 30d;
    access_log off;
}

# 错误页：指向预渲染静态文件，不经过 PHP
error_page 404 /static/404.html;
error_page 403 /static/403.html;
error_page 500 502 503 504 /static/50x.html;

# PHP
location ~ \.php$ {
    try_files $uri =404;
    fastcgi_pass unix:/tmp/php-cgi-83.sock;
    fastcgi_index index.php;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_read_timeout 300;
    include fastcgi_params;
}